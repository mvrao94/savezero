# =====================================================================
# SaveZero - Environment Configuration Template
# Copy this file to '.env' and fill in your details:
#   cp .env.example .env
# =====================================================================

# Required: Your Instagram username (without '@')
INSTAGRAM_USERNAME=your_username_here

# Optional: Override the exact Saved Posts collection URL
# If left commented, automatically defaults to:
# https://www.instagram.com/{INSTAGRAM_USERNAME}/saved/all-posts/
# TARGET_SAVED_URL=https://www.instagram.com/your_username_here/saved/all-posts/

# Mode: 'api' (fast in-browser API ~1.5s/post) or 'ui' (visual modal clicks ~10s/post)
CLEANER_MODE=api

# Dedicated Chrome profile path to avoid locking your daily Chrome browser
# Default: ~/.savezero_session
CHROME_USER_DATA_DIR=~/.savezero_session
CHROME_PROFILE_NAME=Default

# Rate Limiting & Throttling (Seconds per post in API mode)
API_MIN_DELAY=1.2
API_MAX_DELAY=2.0

# Micro-Batch Resting Break (e.g. pause every 40 posts for 30-60s)
BATCH_SIZE_BEFORE_PAUSE=40
BATCH_PAUSE_MIN=30.0
BATCH_PAUSE_MAX=60.0

# Major Milestone Pauses (in minutes)
# Milestone 1: Pause every 1,000 posts (e.g. 15 minutes)
PAUSE_EVERY_1000_MINUTES=15

# Milestone 2: Pause every 2,000 posts (e.g. 60 minutes / 1 hour)
PAUSE_EVERY_2000_MINUTES=60

# Optional: UI Mode Throttling (only applies if CLEANER_MODE=ui)
# MIN_ACTION_DELAY=3.5
# MAX_ACTION_DELAY=6.0
# MICRO_DELAY_MIN=0.8
# MICRO_DELAY_MAX=1.8
